# Database driver: postgres (default) or mongo
DB_DRIVER=postgres

# PostgreSQL connection (used when DB_DRIVER=postgres)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=devdb

# Or use a single connection string:
# DATABASE_URL=host=127.0.0.1 port=5432 user=postgres password=postgres dbname=devdb sslmode=disable

# MongoDB (only when DB_DRIVER=mongo)
MONGO_URI=mongodb://localhost:27017

# Application Port
PORT=:8080

# Environment (development/production)
ENV=development

# SMTP (optional — if unset, confirmations are logged to the console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=bookings@example.com

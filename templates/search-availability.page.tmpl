{{template "base" .}}

{{define "content"}}
    <div class="container">
        <div class="row">
            <div class="col-md-3"></div>
            <div class="col-md-6">
                <h1 class="mt-3">Search for Availability</h1>

                <form id="search-availability-form" action="/search-availability" method="post" novalidate class="needs-validation">
                    <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">

                    <div class="form-group">
                        <label for="room_id">Room</label>
                        <select class="form-control" name="room_id" id="room_id" required>
                            <option value="1" data-name="General's Quarters">General's Quarters</option>
                            <option value="2" data-name="Major's Suite">Major's Suite</option>
                        </select>
                    </div>

                    <div class="row">
                        <div class="col">
                            <div class="row" id="reservation-dates">
                                <div class="col-md-6">
                                    <input required class="form-control" type="text" name="start" id="start" placeholder="Arrival">
                                </div>
                                <div class="col-md-6">
                                    <input required class="form-control" type="text" name="end" id="end" placeholder="Departure">
                                </div>
                            </div>
                        </div>
                    </div>

                    <hr>

                    <button type="button" id="check-availability-button" class="btn btn-primary">Search Availability</button>

                </form>
            </div>
            <div class="col-md-3"></div>
        </div>

    </div>
{{end}}


{{define "js"}}
<script src="/static/js/booking.js"></script>
<script>
    const elem = document.getElementById('reservation-dates');
    new DateRangePicker(elem, {
        format: "yyyy-mm-dd",
        showOnFocus: true,
    });

    document.getElementById('check-availability-button').addEventListener('click', function () {
        const form = document.getElementById('search-availability-form');
        const select = document.getElementById('room_id');
        const roomId = select.value;
        const roomName = select.options[select.selectedIndex].getAttribute('data-name');

        if (!form.checkValidity()) {
            form.classList.add('was-validated');
            return;
        }

        checkAvailability(form, roomId, roomName, '{{.CSRFToken}}')
            .then(data => showAvailabilityResult(data, '{{.CSRFToken}}'));
    });
</script>
{{end}}
